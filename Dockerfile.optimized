# Etapa 1: Build (se mantiene igual para compilar localmente)
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copiar solo lo necesario para restore
COPY ["MazUserBot.csproj", "."]
RUN dotnet restore "MazUserBot.csproj"

# Copiar todo y publicar con optimizaciones de tamaño
COPY . .
RUN dotnet publish "MazUserBot.csproj" -c Release -o /app/publish /p:PublishTrimmed=true /p:PublishReadyToRun=true

# Etapa 2: Runtime optimizado
FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app

# Instalar solo dependencias mínimas necesarias
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copiar aplicación publicada
COPY --from=build /app/publish .

# Crear directorio para sesión
RUN mkdir -p /app/session

# Variable de entorno para sesión
ENV WTelegram_session=/app/session/WTelegram.session

# Entrypoint
ENTRYPOINT ["dotnet", "MazUserBot.dll"]